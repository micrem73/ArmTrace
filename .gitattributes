# Every PDF and Excel workbook in this repository is stored in Git LFS,
# regardless of folder. Extracted tables (Out/) are regenerable from the
# source reports (Reports/) by re-running the pipeline scripts, but both are
# tracked so tables can be diffed and shared.

*.pdf  filter=lfs diff=lfs merge=lfs -text
*.xls  filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text